---
import BaseLayout
  from '../layouts/BaseLayout.astro';

const featuredGames = [
  {
    name: 'Flux',
    category: 'Cards',
    players: '1–4',
    className: 'flux',
    status: 'Planned'
  },
  {
    name: 'SudoRush',
    category: 'Puzzle',
    players: '1–4',
    className: 'sudorush',
    status: 'Planned'
  },
  {
    name: 'Stackfall',
    category: 'Arcade',
    players: '1–4',
    className: 'stackfall',
    status: 'Planned'
  },
  {
    name: 'Diceforge',
    category: 'Strategy',
    players: '1–4',
    className: 'diceforge',
    status: 'Planned'
  }
];
---

<BaseLayout
  title="Kivo Play — Play fast. Play together."
  description="Kivo Play is an open-source multiplayer mini-game platform powered by Astro and Rust."
>
  <main>
    <section class="hero container">
      <div class="hero-copy">
        <div class="hero-kicker">
          <span class="live-dot"></span>

          OPEN-SOURCE MULTIPLAYER ALPHA
        </div>

        <h1>
          Games made
          <span>
            to play together.
          </span>
        </h1>

        <p class="hero-description">
          Fast rooms, quick matches
          and original mini-games built
          for friends, competition and
          chaotic game nights.
        </p>

        <div class="hero-actions">
          <a
            class="button-primary"
            href="/play"
          >
            <span>
              ▶
            </span>

            Play now
          </a>

          <a
            class="button-secondary"
            href="/games"
          >
            Explore games
          </a>
        </div>

        <div class="hero-stats">
          <div>
            <strong>
              1–4
            </strong>

            <span>
              players
            </span>
          </div>

          <div>
            <strong>
              Real-time
            </strong>

            <span>
              multiplayer
            </span>
          </div>

          <div>
            <strong>
              Rust
            </strong>

            <span>
              server authority
            </span>
          </div>
        </div>
      </div>

      <div class="hero-art">
        <div class="hero-glow"></div>

        <div class="floating-card card-red">
          <span class="card-symbol">
            ↯
          </span>

          <strong>
            FLUX
          </strong>
        </div>

        <div class="floating-card card-blue">
          <span>
            8
          </span>

          <span>
            4
          </span>

          <span>
            2
          </span>

          <strong>
            SUDORUSH
          </strong>
        </div>

        <div class="floating-die">
          <span>●</span>
          <span>●</span>
          <span>●</span>
          <span>●</span>
          <span>●</span>
        </div>

        <div class="block-stack">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div class="hero-console">
          <div class="console-top">
            <span>
              KIVO PLAY
            </span>

            <strong>
              ● ONLINE
            </strong>
          </div>

          <div class="console-room">
            <small>
              PRIVATE ROOM
            </small>

            <h2>
              Friday Night
            </h2>

            <div class="console-code">
              A2B3C4
            </div>
          </div>

          <div class="console-players">
            <div>
              <span class="avatar amber">
                A
              </span>

              <div>
                <strong>
                  Alex
                </strong>

                <small>
                  Host
                </small>
              </div>

              <b>
                READY
              </b>
            </div>

            <div>
              <span class="avatar cyan">
                N
              </span>

              <div>
                <strong>
                  Nova
                </strong>

                <small>
                  Player
                </small>
              </div>

              <b>
                READY
              </b>
            </div>
          </div>

          <div class="console-start">
            Start Game
          </div>
        </div>
      </div>
    </section>

    <section class="featured-section container">
      <header class="section-heading">
        <div>
          <span>
            FEATURED GAMES
          </span>

          <h2>
            Pick your chaos.
          </h2>
        </div>

        <a href="/games">
          View all games →
        </a>
      </header>

      <div class="featured-grid">
        {
          featuredGames.map(
            (game) => (
              <a
                class:list={[
                  'featured-card',
                  game.className
                ]}
                href="/games"
              >
                <div class="game-art">
                  {
                    game.name ===
                      'Flux' && (
                      <>
                        <div class="mini-card one">
                          ↯
                        </div>

                        <div class="mini-card two">
                          ↺
                        </div>

                        <div class="mini-card three">
                          ✦
                        </div>
                      </>
                    )
                  }

                  {
                    game.name ===
                      'SudoRush' && (
                      <div class="sudoku-board">
                        {
                          [
                            4,
                            8,
                            2,
                            7,
                            1,
                            3,
                            6,
                            5,
                            9
                          ].map(
                            (
                              number
                            ) => (
                              <span>
                                {number}
                              </span>
                            )
                          )
                        }
                      </div>
                    )
                  }

                  {
                    game.name ===
                      'Stackfall' && (
                      <div class="stack-art">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                      </div>
                    )
                  }

                  {
                    game.name ===
                      'Diceforge' && (
                      <div class="dice-art">
                        <div class="dice-a">
                          ⚄
                        </div>

                        <div class="dice-b">
                          ⚂
                        </div>
                      </div>
                    )
                  }
                </div>

                <div class="game-copy">
                  <div>
                    <span>
                      {game.category}
                    </span>

                    <small>
                      {game.status}
                    </small>
                  </div>

                  <h3>
                    {game.name}
                  </h3>

                  <p>
                    {game.players}
                    {' '}
                    players
                  </p>
                </div>
              </a>
            )
          )
        }
      </div>
    </section>

    <section class="how-it-works container">
      <div class="how-copy">
        <span>
          MULTIPLAYER WITHOUT THE FRICTION
        </span>

        <h2>
          From link to game in seconds.
        </h2>

        <p>
          Kivo Play is being designed
          around short sessions. No
          accounts required for the
          current Alpha: choose a
          nickname, create a room and
          invite your friends.
        </p>
      </div>

      <div class="steps">
        <article>
          <div class="step-number">
            01
          </div>

          <span class="step-icon warm">
            ✦
          </span>

          <h3>
            Create
          </h3>

          <p>
            Give your room a name and
            choose whether it is public
            or private.
          </p>
        </article>

        <article>
          <div class="step-number">
            02
          </div>

          <span class="step-icon cyan">
            ↗
          </span>

          <h3>
            Invite
          </h3>

          <p>
            Share the room code or let
            friends discover your public
            room.
          </p>
        </article>

        <article>
          <div class="step-number">
            03
          </div>

          <span class="step-icon green">
            ✓
          </span>

          <h3>
            Ready
          </h3>

          <p>
            Everyone marks themselves
            ready before the host starts
            the match.
          </p>
        </article>

        <article>
          <div class="step-number">
            04
          </div>

          <span class="step-icon coral">
            ▶
          </span>

          <h3>
            Play
          </h3>

          <p>
            Game state is synchronized
            through the Rust multiplayer
            server.
          </p>
        </article>
      </div>
    </section>

    <section class="cta container">
      <div class="cta-decoration">
        <div class="cta-die">
          ⚅
        </div>

        <div class="cta-card">
          ✦
        </div>
      </div>

      <div>
        <span>
          READY?
        </span>

        <h2>
          Start a room.
          <br />
          Bring your friends.
        </h2>
      </div>

      <a
        class="button-primary"
        href="/play"
      >
        Play Kivo
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    min-height:
      calc(100vh - 84px);

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(440px, 0.85fr);

    align-items: center;

    gap: 4rem;

    padding-top: 4.5rem;
    padding-bottom: 6rem;
  }

  .hero-kicker {
    display: inline-flex;

    align-items: center;

    gap: 0.5rem;

    padding:
      0.45rem 0.7rem;

    border:
      1px solid
      rgba(
        251,
        191,
        36,
        0.18
      );

    border-radius:
      999px;

    color:
      #fde68a;

    background:
      rgba(
        245,
        158,
        11,
        0.065
      );

    font-size:
      0.65rem;

    font-weight:
      900;

    letter-spacing:
      0.12em;
  }

  .live-dot {
    width: 7px;
    height: 7px;

    border-radius:
      50%;

    background:
      #34d399;

    box-shadow:
      0 0 14px
      rgba(
        52,
        211,
        153,
        0.7
      );
  }

  .hero h1 {
    max-width:
      760px;

    margin:
      1.6rem 0;

    font-size:
      clamp(
        4.5rem,
        8vw,
        7.6rem
      );

    line-height:
      0.9;

    letter-spacing:
      -0.07em;
  }

  .hero h1 span {
    display: block;

    color:
      transparent;

    background:
      linear-gradient(
        90deg,
        #fbbf24,
        #fb923c,
        #fb7185
      );

    background-clip:
      text;

    -webkit-background-clip:
      text;
  }

  .hero-description {
    max-width:
      630px;

    margin: 0;

    color:
      rgba(
        255,
        255,
        255,
        0.55
      );

    font-size:
      1.1rem;

    line-height:
      1.75;
  }

  .hero-actions {
    display: flex;

    flex-wrap: wrap;

    gap: 0.8rem;

    margin-top:
      2rem;
  }

  .hero-actions
    .button-primary {
    display: inline-flex;

    gap: 0.5rem;
  }

  .hero-stats {
    display: flex;

    flex-wrap: wrap;

    gap: 2.4rem;

    margin-top:
      3rem;
  }

  .hero-stats div {
    display: grid;

    gap: 0.15rem;
  }

  .hero-stats strong {
    color:
      #fff7ed;

    font-size:
      0.95rem;
  }

  .hero-stats span {
    color:
      rgba(
        255,
        255,
        255,
        0.35
      );

    font-size:
      0.68rem;
  }

  .hero-art {
    position: relative;

    min-height:
      590px;
  }

  .hero-glow {
    position: absolute;

    width: 470px;
    height: 470px;

    top: 80px;
    left: 40px;

    border-radius:
      50%;

    background:
      radial-gradient(
        circle,
        rgba(
          251,
          146,
          60,
          0.13
        ),
        rgba(
          45,
          212,
          191,
          0.04
        ) 45%,
        transparent 72%
      );

    filter:
      blur(10px);
  }

  .hero-console {
    position: absolute;

    width: 385px;

    top: 75px;
    right: 15px;

    padding:
      1.5rem;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.1
      );

    border-radius:
      27px;

    background:
      linear-gradient(
        155deg,
        rgba(
          255,
          247,
          237,
          0.085
        ),
        rgba(
          12,
          16,
          25,
          0.88
        )
      );

    box-shadow:
      0 45px 120px
      rgba(
        0,
        0,
        0,
        0.42
      );

    backdrop-filter:
      blur(24px);

    transform:
      rotate(2deg);
  }

  .console-top {
    display: flex;

    justify-content:
      space-between;

    color:
      rgba(
        255,
        255,
        255,
        0.35
      );

    font-size:
      0.58rem;

    font-weight:
      900;
  }

  .console-top strong {
    color:
      #6ee7b7;
  }

  .console-room {
    margin-top:
      1.7rem;
  }

  .console-room small {
    color:
      #fbbf24;

    font-size:
      0.58rem;

    font-weight:
      900;
  }

  .console-room h2 {
    margin:
      0.35rem 0 1rem;

    font-size:
      1.8rem;
  }

  .console-code {
    padding:
      1rem;

    border:
      1px solid
      rgba(
        251,
        191,
        36,
        0.12
      );

    border-radius:
      14px;

    color:
      #fef3c7;

    background:
      rgba(
        245,
        158,
        11,
        0.045
      );

    text-align:
      center;

    font-size:
      1.7rem;

    font-weight:
      950;

    letter-spacing:
      0.15em;
  }

  .console-players {
    display: grid;

    gap: 0.65rem;

    margin-top:
      1rem;
  }

  .console-players > div {
    display: flex;

    align-items:
      center;

    gap: 0.7rem;

    padding:
      0.75rem;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.06
      );

    border-radius:
      13px;

    background:
      rgba(
        255,
        255,
        255,
        0.025
      );
  }

  .console-players
    > div
    > div {
    display: grid;

    flex: 1;
  }

  .console-players small {
    opacity:
      0.4;
  }

  .console-players b {
    color:
      #6ee7b7;

    font-size:
      0.55rem;
  }

  .avatar {
    width: 38px;
    height: 38px;

    display: grid;

    place-items:
      center;

    border-radius:
      11px;

    color:
      #171717;

    font-weight:
      950;
  }

  .avatar.amber {
    background:
      linear-gradient(
        135deg,
        #fde68a,
        #fb923c
      );
  }

  .avatar.cyan {
    background:
      linear-gradient(
        135deg,
        #67e8f9,
        #60a5fa
      );
  }

  .console-start {
    margin-top:
      1rem;

    padding:
      0.85rem;

    border-radius:
      12px;

    color:
      #271306;

    background:
      linear-gradient(
        135deg,
        #fbbf24,
        #fb923c
      );

    text-align:
      center;

    font-weight:
      950;
  }

  .floating-card {
    position: absolute;

    width: 120px;
    height: 165px;

    display: grid;

    place-items:
      center;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.12
      );

    border-radius:
      20px;

    box-shadow:
      0 25px 60px
      rgba(
        0,
        0,
        0,
        0.25
      );
  }

  .card-red {
    top: 10px;
    left: 15px;

    color:
      #ffe4e6;

    background:
      linear-gradient(
        155deg,
        #be123c,
        #fb7185
      );

    transform:
      rotate(-13deg);
  }

  .card-blue {
    right: 5px;
    bottom: 35px;

    grid-template-columns:
      repeat(3, 1fr);

    color:
      #e0f2fe;

    background:
      linear-gradient(
        155deg,
        #0369a1,
        #22d3ee
      );

    transform:
      rotate(9deg);
  }

  .card-blue strong {
    grid-column:
      1 / -1;

    font-size:
      0.55rem;

    letter-spacing:
      0.08em;
  }

  .card-symbol {
    font-size:
      3.4rem;
  }

  .card-red strong {
    font-size:
      0.6rem;

    letter-spacing:
      0.1em;
  }

  .floating-die {
    position: absolute;

    width: 105px;
    height: 105px;

    left: 10px;
    bottom: 80px;

    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    grid-template-rows:
      repeat(3, 1fr);

    place-items:
      center;

    padding:
      1rem;

    border-radius:
      24px;

    color:
      #2a1605;

    background:
      linear-gradient(
        135deg,
        #fde68a,
        #fb923c
      );

    box-shadow:
      0 25px 60px
      rgba(
        249,
        115,
        22,
        0.2
      );

    transform:
      rotate(-10deg);
  }

  .floating-die
    span:nth-child(1) {
    grid-area:
      1 / 1;
  }

  .floating-die
    span:nth-child(2) {
    grid-area:
      1 / 3;
  }

  .floating-die
    span:nth-child(3) {
    grid-area:
      2 / 2;
  }

  .floating-die
    span:nth-child(4) {
    grid-area:
      3 / 1;
  }

  .floating-die
    span:nth-child(5) {
    grid-area:
      3 / 3;
  }

  .block-stack {
    position: absolute;

    left: 165px;
    bottom: 5px;

    width: 120px;
    height: 110px;

    display: grid;

    grid-template-columns:
      repeat(4, 1fr);

    grid-template-rows:
      repeat(4, 1fr);

    gap: 4px;

    transform:
      rotate(-4deg);
  }

  .block-stack span {
    border-radius:
      4px;
  }

  .block-stack
    span:nth-child(1) {
    grid-area:
      3 / 1 / 5 / 2;

    background:
      #34d399;
  }

  .block-stack
    span:nth-child(2) {
    grid-area:
      2 / 2 / 5 / 3;

    background:
      #fbbf24;
  }

  .block-stack
    span:nth-child(3) {
    grid-area:
      3 / 3 / 5 / 4;

    background:
      #fb7185;
  }

  .block-stack
    span:nth-child(4) {
    grid-area:
      1 / 4 / 5 / 5;

    background:
      #60a5fa;
  }

  .block-stack
    span:nth-child(5) {
    grid-area:
      4 / 1 / 5 / 5;

    background:
      rgba(
        255,
        255,
        255,
        0.1
      );
  }

  .featured-section {
    padding-top:
      3rem;

    padding-bottom:
      7rem;
  }

  .section-heading {
    display: flex;

    align-items:
      end;

    justify-content:
      space-between;

    gap: 1rem;

    margin-bottom:
      2rem;
  }

  .section-heading
    > div
    > span,
  .how-copy > span,
  .cta > div > span {
    color:
      #fb923c;

    font-size:
      0.65rem;

    font-weight:
      950;

    letter-spacing:
      0.14em;
  }

  .section-heading h2,
  .how-copy h2 {
    margin:
      0.4rem 0 0;

    font-size:
      clamp(
        2.2rem,
        5vw,
        4rem
      );

    letter-spacing:
      -0.05em;
  }

  .section-heading a {
    color:
      #fde68a;

    font-size:
      0.8rem;

    font-weight:
      800;
  }

  .featured-grid {
    display: grid;

    grid-template-columns:
      repeat(4, 1fr);

    gap: 1rem;
  }

  .featured-card {
    overflow: hidden;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.07
      );

    border-radius:
      22px;

    background:
      rgba(
        255,
        255,
        255,
        0.025
      );

    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .featured-card:hover {
    transform:
      translateY(-6px);

    box-shadow:
      0 25px 80px
      rgba(
        0,
        0,
        0,
        0.25
      );
  }

  .featured-card.flux:hover {
    border-color:
      rgba(
        251,
        113,
        133,
        0.35
      );
  }

  .featured-card.sudorush:hover {
    border-color:
      rgba(
        34,
        211,
        238,
        0.35
      );
  }

  .featured-card.stackfall:hover {
    border-color:
      rgba(
        52,
        211,
        153,
        0.35
      );
  }

  .featured-card.diceforge:hover {
    border-color:
      rgba(
        251,
        191,
        36,
        0.35
      );
  }

  .game-art {
    height: 220px;

    position: relative;

    overflow: hidden;

    display: grid;

    place-items:
      center;
  }

  .flux .game-art {
    background:
      radial-gradient(
        circle at center,
        rgba(
          251,
          113,
          133,
          0.3
        ),
        rgba(
          127,
          29,
          29,
          0.15
        )
      );
  }

  .sudorush .game-art {
    background:
      radial-gradient(
        circle at center,
        rgba(
          34,
          211,
          238,
          0.27
        ),
        rgba(
          12,
          74,
          110,
          0.16
        )
      );
  }

  .stackfall .game-art {
    background:
      radial-gradient(
        circle at center,
        rgba(
          52,
          211,
          153,
          0.25
        ),
        rgba(
          6,
          78,
          59,
          0.14
        )
      );
  }

  .diceforge .game-art {
    background:
      radial-gradient(
        circle at center,
        rgba(
          251,
          191,
          36,
          0.28
