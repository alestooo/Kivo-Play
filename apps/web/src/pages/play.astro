---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoomLobby from '../components/lobby/RoomLobby.svelte';
---

<BaseLayout
  title="Multiplayer — Kivo Play"
  description="Create or join a Kivo Play multiplayer room."
>
  <main class="multiplayer-page">
    <header class="multiplayer-header">
      <span>KIVO PLAY · ALPHA</span>

      <h1>Multiplayer</h1>

      <p>
        Create a room, invite your friends and play together.
      </p>
    </header>

    <RoomLobby client:load />
  </main>
</BaseLayout>

<style>
  .multiplayer-page {
    width: min(
      1180px,
      calc(100% - 2rem)
    );

    margin: 0 auto;

    padding:
      0.8rem
      0
      1.25rem;
  }

  .multiplayer-header {
    margin-bottom: 0.75rem;

    text-align: center;
  }

  .multiplayer-header > span {
    color: #c084fc;

    font-size: 0.58rem;

    font-weight: 950;

    letter-spacing:
      0.14em;
  }

  .multiplayer-header h1 {
    margin:
      0.18rem
      0;

    font-size:
      clamp(
        2rem,
        4vw,
        3.25rem
      );

    letter-spacing:
      -0.055em;
  }

  .multiplayer-header p {
    margin:
      0.15rem
      0
      0;

    color:
      rgba(
        255,
        255,
        255,
        0.48
      );

    font-size:
      0.78rem;
  }

  @media (
    max-height: 780px
  )
  and (
    min-width: 761px
  ) {
    .multiplayer-page {
      padding-top:
        0.45rem;
    }

    .multiplayer-header {
      margin-bottom:
        0.45rem;
    }

    .multiplayer-header h1 {
      font-size:
        2.25rem;
    }
  }
</style>