---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kivo Play',
  description =
    'Fast multiplayer mini-games built with Astro and Rust.'
} = Astro.props;

const pathname =
  Astro.url.pathname;
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#0b0d12"
    />

    <link
      rel="icon"
      href="/favicon.ico"
    />

    <title>{title}</title>
  </head>

  <body>
    <div
      class="global-background"
      aria-hidden="true"
    >
      <div class="background-orb orb-one"></div>
      <div class="background-orb orb-two"></div>
      <div class="background-orb orb-three"></div>

      <div class="background-grid"></div>
    </div>

    <header class="site-nav">
      <a
        class="brand"
        href="/"
      >
        <span class="brand-icon">
          K
        </span>

        <span class="brand-copy">
          <strong>
            Kivo Play
          </strong>

          <small>
            ALPHA
          </small>
        </span>
      </a>

      <nav class="nav-links">
        <a
          class:list={[
            {
              active:
                pathname === '/'
            }
          ]}
          href="/"
        >
          Home
        </a>

        <a
          class:list={[
            {
              active:
                pathname.startsWith(
                  '/games'
                )
            }
          ]}
          href="/games"
        >
          Games
        </a>

        <a
          class:list={[
            'nav-play',
            {
              active:
                pathname.startsWith(
                  '/play'
                )
            }
          ]}
          href="/play"
        >
          Play
        </a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div>
        <strong>
          Kivo Play
        </strong>

        <span>
          Play fast. Play together.
        </span>
      </div>

      <span>
        Open-source multiplayer
        experiment · Alpha
      </span>
    </footer>
  </body>
</html>