---
import BaseLayout
  from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kivo Play — Play fast. Play together."
  description="Kivo Play is an open-source multiplayer mini-game platform powered by Astro, Svelte and Rust."
>
  <main>
    <section class="hero container">
      <div class="hero-copy">
        <span class="hero-label">
          OPEN-SOURCE · ALPHA
        </span>

        <h1>
          Play fast.
          <br />
          <span>
            Play together.
          </span>
        </h1>

        <p>
          A multiplayer mini-game
          platform built for quick
          matches, friends, competition
          and experimentation.
        </p>

        <div class="hero-actions">
          <a
            class="button-primary"
            href="/play"
          >
            Start Playing
          </a>

          <a
            class="button-secondary"
            href="/games"
          >
            Explore Games
          </a>
        </div>

        <div class="tech-row">
          <span>
            Astro
          </span>

          <span>
            Svelte
          </span>

          <span>
            TypeScript
          </span>

          <span>
            Rust
          </span>

          <span>
            Axum
          </span>

          <span>
            WebSockets
          </span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="visual-card visual-card-back">
        </div>

        <div class="visual-card visual-card-main">
          <div class="visual-top">
            <span>
              PRIVATE ROOM
            </span>

            <strong>
              ● ONLINE
            </strong>
          </div>

          <h2>
            Lobby
          </h2>

          <div class="fake-code">
            K7MF2Q
          </div>

          <div class="fake-player active">
            <div>
              A
            </div>

            <span>
              Alejandro
              <small>
                You · Host
              </small>
            </span>

            <strong>
              READY
            </strong>
          </div>

          <div class="fake-player">
            <div>
              N
            </div>

            <span>
              Nova
              <small>
                Player
              </small>
            </span>

            <strong>
              READY
            </strong>
          </div>

          <div class="fake-start">
            Start Game
          </div>
        </div>
      </div>
    </section>

    <section class="features container">
      <article>
        <span>
          01
        </span>

        <h2>
          Fast rooms
        </h2>

        <p>
          Create a room, share a
          six-character code and start
          playing.
        </p>
      </article>

      <article>
        <span>
          02
        </span>

        <h2>
          Real-time
        </h2>

        <p>
          Multiplayer state is
          synchronized through a Rust
          WebSocket server.
        </p>
      </article>

      <article>
        <span>
          03
        </span>

        <h2>
          Server authority
        </h2>

        <p>
          Important game results are
          validated and generated by the
          backend.
        </p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    min-height:
      calc(100vh - 90px);

    display: grid;

    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(340px, 0.9fr);

    align-items: center;

    gap: 5rem;

    padding-top: 5rem;
    padding-bottom: 6rem;
  }

  .hero-label {
    display: inline-flex;

    padding:
      0.45rem 0.75rem;

    border:
      1px solid
      rgba(192, 132, 252, 0.2);

    border-radius: 999px;

    color: #d8b4fe;

    background:
      rgba(168, 85, 247, 0.08);

    font-size: 0.7rem;
    font-weight: 900;

    letter-spacing: 0.15em;
  }

  .hero h1 {
    margin:
      1.5rem 0;

    font-size:
      clamp(
        4rem,
        8vw,
        7rem
      );

    line-height: 0.92;

    letter-spacing:
      -0.065em;
  }

  .hero h1 span {
    color: #c084fc;
  }

  .hero-copy > p {
    max-width: 620px;

    margin: 0;

    color:
      rgba(255, 255, 255, 0.58);

    font-size: 1.1rem;

    line-height: 1.7;
  }

  .hero-actions {
    display: flex;

    flex-wrap: wrap;

    gap: 0.8rem;

    margin-top: 2rem;
  }

  .tech-row {
    display: flex;

    flex-wrap: wrap;

    gap: 0.55rem;

    margin-top: 2.5rem;
  }

  .tech-row span {
    padding:
      0.4rem 0.65rem;

    border:
      1px solid
      rgba(255, 255, 255, 0.07);

    border-radius: 999px;

    color:
      rgba(255, 255, 255, 0.45);

    background:
      rgba(255, 255, 255, 0.025);

    font-size: 0.68rem;
    font-weight: 700;
  }

  .hero-visual {
    position: relative;

    min-height: 540px;
  }

  .visual-card {
    position: absolute;

    border:
      1px solid
      rgba(255, 255, 255, 0.1);

    border-radius: 28px;
  }

  .visual-card-back {
    inset:
      70px -20px 10px 60px;

    transform:
      rotate(7deg);

    background:
      linear-gradient(
        145deg,
        rgba(124, 58, 237, 0.16),
        rgba(59, 130, 246, 0.04)
      );
  }

  .visual-card-main {
    inset:
      20px 30px 40px 0;

    padding: 2rem;

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.075),
        rgba(255, 255, 255, 0.02)
      );

    box-shadow:
      0 40px 100px
      rgba(0, 0, 0, 0.35);

    backdrop-filter:
      blur(20px);
  }

  .visual-top {
    display: flex;

    justify-content:
      space-between;

    color:
      rgba(255, 255, 255, 0.4);

    font-size: 0.65rem;
    font-weight: 900;
  }

  .visual-top strong {
    color: #86efac;
  }

  .visual-card h2 {
    margin-top: 2rem;

    font-size: 2rem;
  }

  .fake-code {
    margin: 1rem 0 2rem;

    padding: 1.2rem;

    border-radius: 16px;

    background:
      rgba(255, 255, 255, 0.04);

    text-align: center;

    font-size: 2rem;
    font-weight: 900;

    letter-spacing: 0.18em;
  }

  .fake-player {
    display: flex;

    align-items: center;

    gap: 0.8rem;

    margin-bottom: 0.7rem;

    padding: 0.85rem;

    border:
      1px solid
      rgba(255, 255, 255, 0.07);

    border-radius: 14px;
  }

  .fake-player.active {
    border-color:
      rgba(74, 222, 128, 0.2);

    background:
      rgba(34, 197, 94, 0.04);
  }

  .fake-player > div {
    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    border-radius: 12px;

    background:
      linear-gradient(
        135deg,
        #7c3aed,
        #4f46e5
      );

    font-weight: 900;
  }

  .fake-player > span {
    display: grid;

    flex: 1;

    font-weight: 800;
  }

  .fake-player small {
    margin-top: 0.1rem;

    opacity: 0.4;

    font-size: 0.65rem;
  }

  .fake-player strong {
    color: #86efac;

    font-size: 0.6rem;
  }

  .fake-start {
    margin-top: 1.2rem;

    padding: 0.95rem;

    border-radius: 14px;

    color: white;

    background:
      linear-gradient(
        135deg,
        #7c3aed,
        #a855f7
      );

    text-align: center;

    font-weight: 900;
  }

  .features {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 1rem;

    padding-bottom: 7rem;
  }

  .features article {
    padding: 1.5rem;

    border:
      1px solid
      rgba(255, 255, 255, 0.07);

    border-radius: 20px;

    background:
      rgba(255, 255, 255, 0.025);
  }

  .features article > span {
    color: #c084fc;

    font-size: 0.65rem;
    font-weight: 900;
  }

  .features h2 {
    margin:
      1rem 0 0.5rem;
  }

  .features p {
    margin: 0;

    color:
      rgba(255, 255, 255, 0.5);

    line-height: 1.6;
  }

  @media (
    max-width: 900px
  ) {
    .hero {
      grid-template-columns:
        1fr;

      gap: 2rem;
    }

    .hero-visual {
      min-height: 500px;
    }

    .features {
      grid-template-columns:
        1fr;
    }
  }
</style>